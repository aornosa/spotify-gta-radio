# Copy to .env.local (or run `npm run setup`) and fill in your Spotify app's keys.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered on your Spotify app. Spotify rejects "localhost";
# use 127.0.0.1. On a hosted deploy you can leave this unset: the site's own
# https://<your-domain>/api/auth/callback is used.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
